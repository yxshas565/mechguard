
"use client";

import {
  Activity,
  ArrowRight,
  BrainCircuit,
  Check,
  ChevronDown,
  CircleDot,
  CloudUpload,
  Eye,
  FileCode2,
  Layers3,
  Moon,
  Network,
  Play,
  RefreshCw,
  ShieldCheck,
  Sparkles,
  Sun,
  Zap,
  Upload,
  X,
} from "lucide-react";
import type { LucideIcon } from "lucide-react";
import { useEffect, useMemo, useRef, useState } from "react";

type Stage = "attest" | "watch" | "review";

type ProductLayer = {
  id: Stage;
  number: string;
  title: string;
  short: string;
  description: string;
  icon: LucideIcon;
};

const productLayers: ProductLayer[] = [
  {
    id: "attest",
    number: "01",
    title: "Attest",
    short: "Training-time weight geometry",
    description:
      "Measure how internal weight geometry changes as a model is fine-tuned.",
    icon: BrainCircuit,
  },
  {
    id: "watch",
    number: "02",
    title: "Watch",
    short: "Deployment-time representations",
    description:
      "Monitor hidden representations across interacting agents where text-level monitoring can miss structure.",
    icon: Eye,
  },
  {
    id: "review",
    number: "03",
    title: "Review",
    short: "Evidence and investigation",
    description:
      "Connect signals, model context, and evidence into an investigation surface.",
    icon: ShieldCheck,
  },
];

const fileTypes = ".json,.jsonl,.csv,.txt,.yaml,.yml";

export default function Home() {
  const [dark, setDark] = useState(true);
  const [themeReady, setThemeReady] = useState(false);
  const [stage, setStage] = useState<Stage>("attest");
  const [activeNode, setActiveNode] = useState<Stage>("attest");
  const [selectedUseCase, setSelectedUseCase] = useState(0);
  const [comparison, setComparison] = useState(0);
  const [payload, setPayload] = useState("");
  const [file, setFile] = useState<File | null>(null);
  const [dragging, setDragging] = useState(false);
  const [running, setRunning] = useState(false);
  const [runStep, setRunStep] = useState(0);
  const [result, setResult] = useState<unknown>(null);
  const [error, setError] = useState("");
  const [showRaw, setShowRaw] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    const saved = window.localStorage.getItem("mechguard-theme");

    if (saved === "light") {
      setDark(false);
      document.documentElement.classList.remove("dark");
    } else {
      setDark(true);
      document.documentElement.classList.add("dark");
    }

    setThemeReady(true);
  }, []);

  function toggleTheme() {
    const next = !dark;
    setDark(next);
    document.documentElement.classList.toggle("dark", next);
    window.localStorage.setItem("mechguard-theme", next ? "dark" : "light");
  }

  function chooseFile(nextFile: File | null) {
    if (!nextFile) return;

    const allowed =
      nextFile.name.match(/\.(json|jsonl|csv|txt|yaml|yml)$/i) !== null;

    if (!allowed) {
      setError("Use a JSON, JSONL, CSV, TXT, YAML, or YML file.");
      return;
    }

    setError("");
    setFile(nextFile);
    setPayload("");
  }

  function clearInput() {
    setFile(null);
    setPayload("");
    setResult(null);
    setError("");

    if (inputRef.current) {
      inputRef.current.value = "";
    }
  }

  async function runAnalysis() {
    if (!file && !payload.trim()) {
      setError("Upload an input file or paste an analysis payload first.");
      return;
    }

    setRunning(true);
    setResult(null);
    setError("");
    setShowRaw(false);
    setRunStep(0);

    const timer = window.setInterval(() => {
      setRunStep((current) => Math.min(current + 1, 3));
    }, 900);

    try {
      let response: Response;

      if (file) {
        const form = new FormData();
        form.append("stage", stage);
        form.append("file", file);

        response = await fetch("/api/analyze", {
          method: "POST",
          body: form,
        });
      } else {
        response = await fetch("/api/analyze", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            stage,
            input: payload.trim(),
          }),
        });
      }

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          typeof data?.error === "string"
            ? data.error
            : "The MechGuard backend returned an error."
        );
      }

      setRunStep(3);
      setResult(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "The analysis request failed."
      );
    } finally {
      window.clearInterval(timer);
      setRunning(false);
    }
  }

  const layers = productLayers.map((layer) => ({
    ...layer,
    eyebrow:
      layer.id === "attest"
        ? "ATTEST"
        : layer.id === "watch"
          ? "WATCH"
          : "REVIEW",
  }));

  function scrollToWorkspace(nextStage?: Stage) {
    if (nextStage) {
      setStage(nextStage);
      setActiveNode(nextStage);
    }

    window.setTimeout(() => {
      document
        .getElementById("workspace")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    }, 0);
  }

  const selectedLayer = useMemo(
    () => productLayers.find((item) => item.id === stage) ?? productLayers[0],
    [stage]
  );

  const selectedIndex = productLayers.findIndex(
    (item) => item.id === activeNode
  );

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#f5f7f5] text-[#0a100c] transition-colors duration-500 dark:bg-[#050705] dark:text-white">

      {/* NAV */}
      <nav className="sticky top-0 z-50 border-b border-black/[.07] bg-[#f5f7f5]/90 backdrop-blur-xl dark:border-white/[.08] dark:bg-[#050705]/90">
        <div className="mx-auto flex h-[70px] max-w-7xl items-center justify-between px-5 lg:px-8">

          <a href="#" className="flex items-center gap-2.5">
            <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-[#101512] text-white dark:bg-white dark:text-black">
              <Activity size={16} />
            </span>
            <span className="text-sm font-semibold tracking-[-.02em]">
              MechGuard
            </span>
          </a>

          <div className="hidden items-center gap-8 text-xs text-black/50 dark:text-white/45 md:flex">
            <a href="#system" className="transition hover:text-black dark:hover:text-white">System</a>
            <a href="#product" className="transition hover:text-black dark:hover:text-white">Product</a>
            <a href="#try" className="transition hover:text-black dark:hover:text-white">Try MechGuard</a>
            <a href="#evidence" className="transition hover:text-black dark:hover:text-white">Evidence</a>
          </div>

          <button
            type="button"
            onClick={() => {
              const next = !dark;
              setDark(next);
              document.documentElement.classList.toggle("dark", next);
              window.localStorage.setItem(
                "mechguard-theme",
                next ? "dark" : "light"
              );
            }}
            aria-label={dark ? "Switch to light mode" : "Switch to dark mode"}
            className="mechguard-theme-toggle group flex h-10 items-center gap-2 rounded-full border border-black/10 bg-white px-3 text-[10px] font-semibold text-black transition hover:border-emerald-500/40 hover:shadow-sm dark:border-white/10 dark:bg-white/[.06] dark:text-white"
          >
            <span className="relative flex h-4 w-4 items-center justify-center">
              {dark ? <Sun size={14} /> : <Moon size={14} />}
            </span>
            <span className="hidden sm:block">
              {dark ? "Light" : "Dark"}
            </span>
          </button>
        </div>
      </nav>

      {/* HERO */}
      <section className="mx-auto max-w-7xl px-5 pb-20 pt-20 lg:px-8 lg:pb-28 lg:pt-28">
        <div className="grid items-center gap-14 lg:grid-cols-[.85fr_1.15fr]">

          <div>
            <div className="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/[.06] px-3 py-1.5 text-[9px] font-semibold uppercase tracking-[.18em] text-emerald-700 dark:text-emerald-300">
              <span className="live-dot h-1.5 w-1.5 rounded-full bg-emerald-500" />
              Mechanistic AI safety monitoring
            </div>

            <h1 className="mt-7 max-w-2xl text-5xl font-semibold leading-[.98] tracking-[-.06em] sm:text-6xl lg:text-[76px]">
              See what&apos;s
              <span className="block text-black/30 dark:text-white/25">
                happening inside.
              </span>
            </h1>

            <p className="mt-7 max-w-xl text-[15px] leading-8 text-black/55 dark:text-white/50">
              MechGuard instruments internal signals across the AI lifecycle —
              from weight-space changes during fine-tuning to hidden
              representations across deployed agent systems.
            </p>

            <div className="mt-9 flex flex-wrap gap-3">
              <a
                href="#try"
                className="inline-flex items-center gap-2 rounded-full bg-[#101512] px-5 py-3 text-xs font-semibold text-white transition hover:-translate-y-0.5 dark:bg-white dark:text-black"
              >
                Try the prototype
                <ArrowRight size={14} />
              </a>

              <a
                href="#system"
                className="inline-flex items-center gap-2 rounded-full border border-black/10 px-5 py-3 text-xs font-semibold transition hover:border-emerald-500/30 dark:border-white/10"
              >
                Explore the system
              </a>
            </div>

            <div className="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-[10px] text-black/35 dark:text-white/30">
              <span>Training-time instrumentation</span>
              <span>Deployment-time monitoring</span>
              <span>Research-backed evidence</span>
            </div>
          </div>

          {/* INTERACTIVE SYSTEM MAP */}
          <div
            id="system"
            className="relative rounded-[28px] border border-black/10 bg-white p-4 shadow-[0_35px_100px_rgba(0,0,0,.08)] dark:border-white/10 dark:bg-[#090d0b] dark:shadow-none sm:p-5"
          >
            <div className="flex items-center justify-between px-2 pb-4">
              <div>
                <p className="text-[9px] font-semibold uppercase tracking-[.2em] text-black/35 dark:text-white/30">
                  MechGuard system
                </p>
                <p className="mt-1 text-[11px] text-black/45 dark:text-white/35">
                  Select a layer to inspect the signal path
                </p>
              </div>

              <div className="flex items-center gap-2 rounded-full border border-emerald-500/20 px-3 py-1.5 text-[8px] font-semibold uppercase tracking-[.15em] text-emerald-700 dark:text-emerald-300">
                <span className="live-dot h-1.5 w-1.5 rounded-full bg-emerald-500" />
                Live map
              </div>
            </div>

            <div className="relative min-h-[430px] overflow-hidden rounded-2xl bg-[#f0f3f0] dark:bg-[#060906]">

              {/* flowing paths */}
              <svg
                viewBox="0 0 900 430"
                preserveAspectRatio="none"
                className="pointer-events-none absolute inset-0 h-full w-full"
              >
               <path
                 id="heroPathB"
                 d="M120 260 C240 260 250 400 370 400 C470 400 470 260 570 260 C680 260 680 370 800 370"
               />
 
             <path
                 id="heroPathA"
               d="M120 260 C230 260 235 120 370 120 C470 120 450 260 570 260 C690 260 680 150 800 150"
               className="flow-track"
             />
 
             <path
               d="M120 260 C240 260 250 400 370 400 C470 400 470 260 570 260 C680 260 680 370 800 370"
               className="flow-track"
             />
 
             <circle r="5" className="flow-packet">
               <animateMotion
                 dur="3.6s"
                 repeatCount="indefinite"
                 rotate="auto"
               >
                 <mpath href="#heroPathA" />
               </animateMotion>
             </circle>
 
             <circle r="5" className="flow-packet">
               <animateMotion
                 dur="4.2s"
                 begin="1.2s"
                 repeatCount="indefinite"
                 rotate="auto"
               >
                 <mpath href="#heroPathB" />
               </animateMotion>
             </circle>
           </svg>
 
           <div className="system-node model-node" data-mechguard-stage="attest">
             <span className="node-icon">
               <BrainCircuit size={18} />
             </span>
             <b>MODEL</b>
             <small>fine-tuned system</small>
           </div>
 
           <button
             type="button"
             className={`system-node attest-node ${
               activeNode === "attest" ? "node-selected" : ""
             }`}
             onClick={() => scrollToWorkspace}
           >
             <span className="node-icon">
               <Layers3 size={18} />
             </span>
             <b>ATTEST</b>
             <small>weight geometry</small>
             <span className="node-number">01</span>
           </button>
 
           <button
             type="button"
             className={`system-node watch-node ${
               activeNode === "watch" ? "node-selected" : ""
             }`}
             onClick={() => scrollToWorkspace}
           >
             <span className="node-icon">
               <Eye size={18} />
             </span>
             <b>WATCH</b>
             <small>agent representations</small>
             <span className="node-number">02</span>
           </button>
 
           <button
             type="button"
             className={`system-node review-node ${
               activeNode === "review" ? "node-selected" : ""
             }`}
             onClick={() => scrollToWorkspace}
           >
             <span className="node-icon">
               <ShieldCheck size={18} />
             </span>
             <b>REVIEW</b>
             <small>evidence + context</small>
             <span className="node-number">03</span>
           </button>
         </div>
          </div>
       </section>
 
       {/* PRODUCT */}
       <section id="product" className="section product-section">
         <div className="section-heading">
           <div className="eyebrow">THE PRODUCT</div>
           <h2>One layer. Three jobs.</h2>
           <p>
             MechGuard connects training-time model dynamics, deployment-time
             representations and human investigation into one workflow.
           </p>
         </div>
 
         <div className="product-grid">
           {layers.map((layer) => {
             const Icon = layer.icon;
             const selected = stage === layer.id;
 
             return (
               <button
                 type="button"
                 key={layer.id}
                 className={`product-card ${
                   selected ? "product-card-selected" : ""
                 }`}
                 onClick={() => scrollToWorkspace(layer.id)}
               >
                 <div className="card-topline">
                   <span className="card-icon">
                     <Icon size={20} />
                   </span>
                   <span>{layer.number}</span>
                 </div>
 
                 <div className="product-card-body">
                   <div className="card-eyebrow">{layer.eyebrow}</div>
                   <h3>{layer.title}</h3>
                   <p>{layer.description}</p>
                 </div>
 
                 <div className="card-action">
                   {selected ? "Selected · inspect below" : "Open workspace"}
                   <ArrowRight size={14} />
                 </div>
 
                 <div className="card-hover-line" />
               </button>
             );
           })}
         </div>
       </section>
 
       {/* ARCHITECTURE */}
       <section id="architecture" className="section architecture-section">
         <div className="section-heading wide">
           <div className="eyebrow">SYSTEM ARCHITECTURE</div>
           <h2>A signal flows through the system.</h2>
           <p>
             Instead of stopping at inputs and outputs, MechGuard follows the
             internal signal from instrumentation to evidence.
           </p>
         </div>
 
         <div className="pipeline">
           {[
             ["01", "Instrument", "Attach to the internal model or agent representation."],
             ["02", "Measure", "Extract geometric and representation-level signals."],
             ["03", "Surface", "Expose changes through an evidence-linked workspace."],
             ["04", "Review", "Give safety teams the context to investigate."],
           ].map(([num, title, text], index) => (
             <button
               type="button"
               key={num}
               className={`pipeline-step ${
                 selectedUseCase === index ? "pipeline-step-selected" : ""
               }`}
               onClick={() => setSelectedUseCase(index)}
             >
               <span className="pipeline-num">{num}</span>
               <span className="pipeline-dot">
                 <span />
               </span>
               <span className="pipeline-title">{title}</span>
               <span className="pipeline-text">{text}</span>
               {index < 3 && <ArrowRight className="pipeline-arrow" size={17} />}
             </button>
           ))}
         </div>
 
         <div className="pipeline-live">
           <div className="pipeline-live-copy">
             <span className="live-indicator" />
             <span>LIVE SIGNAL PATH</span>
           </div>
 
           <div className="live-track">
             <div className="live-fill" />
             <span className="live-packet" />
           </div>
 
           <span className="pipeline-live-label">
             model → internal signal → measurement → evidence
           </span>
         </div>
       </section>
 
       {/* WHERE IT FITS */}
       <section className="section fit-section">
         <div className="section-heading">
           <div className="eyebrow">WHERE IT FITS</div>
           <h2>Internal observability for AI infrastructure.</h2>
         </div>
 
         <div className="fit-grid">
           {[
             {
               title: "AI platforms",
               text: "Understand internal model changes across fine-tuning and evaluation pipelines.",
               icon: BrainCircuit,
               icon: BrainCircuit,
             },
             {
               title: "AI safety",
               text: "Investigate signals that ordinary behavioural evaluations can miss.",
               icon: ShieldCheck,
             },
             {
               title: "Agent infrastructure",
               text: "Monitor representations across interacting autonomous agents.",
               icon: Network,
             },
             {
               title: "ML infrastructure",
               text: "Add internal observability to existing model workflows.",
               icon: Layers3,
             },
           ].map((item, index) => {
             const Icon = item.icon;
 
             return (
               <button
                 type="button"
                 key={item.title}
                 className={`fit-card ${
                   selectedUseCase === index ? "fit-card-selected" : ""
                 }`}
                 onClick={() => setSelectedUseCase(index)}
               >
                 <span className="fit-icon">
                   <Icon size={18} />
                 </span>
                 <span className="fit-index">0{index + 1}</span>
                 <strong>{item.title}</strong>
                 <p>{item.text}</p>
                 <span className="fit-more">
                   {selectedUseCase === index ? "Selected" : "Explore"}
                   <ArrowRight size={13} />
                 </span>
               </button>
             );
           })}
         </div>
       </section>
 
       {/* WHY THIS LAYER */}
       <section className="section layer-section">
         <div className="section-heading">
           <div className="eyebrow">WHY THIS LAYER</div>
           <h2>Existing telemetry sees the boundary.</h2>
           <p>
             MechGuard is designed for the layer below application behaviour:
             the model state itself.
           </p>
         </div>
 
         <div className="comparison">
           {[
             {
               name: "Application telemetry",
               sees: "Inputs, outputs, latency, errors",
               difference: "Behaviour at the boundary",
             },
             {
               name: "Execution tracing",
               sees: "Tools, agents, workflows",
               difference: "What the system executes",
             },
             {
               name: "MechGuard",
               sees: "Weights and hidden representations",
               difference: "Internal model state",
             },
           ].map((row, index) => (
             <button
               type="button"
               key={row.name}
               className={`comparison-row ${
                 comparison === index ? "comparison-selected" : ""
               }`}
               onClick={() => setComparison(index)}
             >
               <span>{row.name}</span>
               <span>{row.sees}</span>
               <span>{row.difference}</span>
             </button>
           ))}
         </div>
       </section>
 
       {/* WORKSPACE */}
       <section id="workspace" className="section workspace-section">
         <div className="workspace-shell">
           <div className="workspace-tabs">
             {layers.map((layer) => (
               <button
                 type="button"
                 key={layer.id}
                 className={stage === layer.id ? "workspace-tab active" : "workspace-tab"}
                 onClick={() => setStage(layer.id)}
               >
                 {layer.title}
               </button>
             ))}
           </div>
 
           {!stage ? (
             <div className="workspace-empty">
               <div className="workspace-empty-icon">
                 <Zap size={23} />
               </div>
               <div>
                 <div className="workspace-empty-label">CHOOSE A MONITOR</div>
                 <h3>Select Attest, Watch or Review.</h3>
                 <p>
                   Nothing is pre-selected. Choose a monitoring layer above to
                   configure the workspace.
                 </p>
               </div>
             </div>
           ) : (
             <div className="workspace-content">
               <div className="workspace-control">
                 <div className="workspace-copy">
                   <div className="eyebrow">{selectedLayer?.eyebrow}</div>
                   <h2>
                     {stage === "attest" && "See how a model changes while it learns."}
                     {stage === "watch" && "See what agents reveal beneath the conversation."}
                     {stage === "review" && "Keep evidence and investigation together."}
                   </h2>
 
                   <p>
                     {selectedLayer?.description}
                   </p>
 
                   <div className="workspace-buttons">
                     <button
                       type="button"
                       className="primary-btn"
                       disabled={running}
                       onClick={runAnalysis}
                     >
                       <Play size={14} fill="currentColor" />
                       {running ? "Running MechGuard…" : "Run MechGuard"}
                     </button>
 
                     <button
                       type="button"
                       className="secondary-btn"
                       onClick={() => inputRef.current?.click()}
                     >
                       <Upload size={14} />
                       Attach artifact
                     </button>
                   </div>
 
                   {/* Proper file input: NOT nested inside a button */}
                   <input
                     ref={inputRef}
                     type="file"
                     accept={fileTypes}
                     className="sr-only"
                     onChange={(event) =>
                       chooseFile(event.target.files?.[0] ?? null)
                     }
                   />
 
                   <div
                     className={`drop-zone ${
                       dragging ? "drop-zone-dragging" : ""
                     }`}
                     onDragOver={(event) => {
                       event.preventDefault();
                       setDragging(true);
                     }}
                     onDragLeave={() => setDragging(false)}
                     onDrop={(event) => {
                       event.preventDefault();
                       setDragging(false);
                       chooseFile(event.dataTransfer.files?.[0] ?? null);
                     }}
                     onClick={() => inputRef.current?.click()}
                     role="button"
                     tabIndex={0}
                     onKeyDown={(event) => {
                       if (event.key === "Enter" || event.key === " ") {
                         inputRef.current?.click();
                       }
                     }}
                   >
                     {file ? (
                       <>
                         <FileCode2 size={25} />
                         <strong>{file.name}</strong>
                         <span>
                           {(file.size / 1024).toFixed(1)} KB · ready to inspect
                         </span>
                       </>
                     ) : (
                       <>
                         <CloudUpload size={25} />
                         <strong>Drop a research artifact here</strong>
                         <span>
                           Click to browse · JSON · JSONL · CSV · TXT · YAML
                         </span>
                       </>
                     )}
                   </div>
 
                   {file && (
                     <button
                       type="button"
                       className="remove-file"
                       onClick={clearInput}
                     >
                       <X size={12} />
                       Remove artifact
                     </button>
                   )}
 

            <textarea
              value={payload}
              onChange={(event) => {
                setPayload(event.target.value);
                if (event.target.value) setFile(null);
              }}
              placeholder='{"model":"...","checkpoint":"...","analysis":"..."}'
              className="min-h-32 w-full resize-y rounded-2xl border border-black/10 bg-[#f7f9f7] p-4 font-mono text-[11px] leading-6 outline-none transition placeholder:text-black/25 focus:border-emerald-500/50 dark:border-white/10 dark:bg-[#060906] dark:placeholder:text-white/20"
            />

            {error && (
              <div className="mt-4 flex items-start gap-2 rounded-xl border border-red-500/20 bg-red-500/[.05] px-4 py-3 text-xs leading-5 text-red-600 dark:text-red-300">
                <X size={14} className="mt-0.5 shrink-0" />
                <span>{error}</span>
              </div>
            )}

            {running && (
              <div className="mt-5 overflow-hidden rounded-2xl border border-emerald-500/20 bg-emerald-500/[.04] p-4">
                <div className="flex items-center justify-between text-[9px] font-semibold uppercase tracking-[.14em]">
                  <span className="text-emerald-700 dark:text-emerald-300">
                    Loading measured internal signals
                  </span>
                  <RefreshCw size={12} className="animate-spin text-emerald-600" />
                </div>

                <div className="relative mt-4 h-1 overflow-hidden rounded-full bg-emerald-500/10">
                  <div
                    className="h-full rounded-full bg-emerald-500 transition-all duration-700"
                    style={{ width: `${Math.max(12, (runStep + 1) * 25)}%` }}
                  />
                </div>

                <div className="mt-3 grid grid-cols-3 gap-2 text-[8px] text-black/35 dark:text-white/30">
                  <span className={runStep >= 0 ? "text-emerald-600" : ""}>ingest</span>
                  <span className={runStep >= 1 ? "text-emerald-600" : ""}>measure</span>
                  <span className={runStep >= 2 ? "text-emerald-600" : ""}>evaluate</span>
                </div>
              </div>
            )}

            <button
              type="button"
              disabled={running}
              onClick={runAnalysis}
              className="mt-5 inline-flex items-center gap-2 rounded-full bg-[#101512] px-6 py-3.5 text-xs font-semibold text-white transition hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-45 dark:bg-white dark:text-black"
            >
              <Play size={13} fill="currentColor" />
              {running ? "Loading evidence…" : "Inspect evidence"}
              <ArrowRight size={13} />
            </button>

            {/* RESULT */}
            {result !== null && (
              <div className="mt-6 rounded-2xl border border-emerald-500/25 bg-emerald-500/[.05] p-5">
                <div className="flex flex-wrap items-center justify-between gap-3">
                  <div className="flex items-center gap-2">
                    <CircleDot size={15} className="text-emerald-600 dark:text-emerald-300" />
                    <span className="text-xs font-semibold">
                      Evidence loaded
                    </span>
                  </div>

                  <span className="rounded-full bg-emerald-500/10 px-2.5 py-1 text-[8px] font-semibold uppercase tracking-[.12em] text-emerald-700 dark:text-emerald-300">
                    research evidence
                  </span>
                </div>

                <div className="mt-5 grid gap-2 sm:grid-cols-3">
                  {[
                    ["stage", stage],
                    ["input", file?.name ?? "payload"],
                    ["status", "received"],
                  ].map(([label, value]) => (
                    <div
                      key={label}
                      className="rounded-xl border border-black/5 bg-white/60 p-3 dark:border-white/5 dark:bg-black/20"
                    >
                      <p className="text-[8px] uppercase tracking-[.13em] text-black/30 dark:text-white/25">
                        {label}
                      </p>
                      <p className="mt-1 truncate text-[10px] font-semibold">
                        {value}
                      </p>
                    </div>
                  ))}
                </div>

                <button
                  type="button"
                  onClick={() => setShowRaw((value) => !value)}
                  className="mt-4 flex items-center gap-2 text-[9px] font-semibold text-emerald-700 dark:text-emerald-300"
                >
                  {showRaw ? "Hide response" : "Inspect response"}
                  <ChevronDown
                    size={12}
                    className={showRaw ? "rotate-180 transition" : "transition"}
                  />
                </button>

                {showRaw && (
                  <pre className="mt-3 max-h-80 overflow-auto rounded-xl bg-black/[.04] p-4 text-[9px] leading-5 dark:bg-white/[.04]">
                    {JSON.stringify(result, null, 2)}
                  </pre>
                )}
              </div>
            )}
          </div>
        </div>
      </section>

      {/* EVIDENCE */}
      <section id="evidence" className="border-t border-black/[.06] bg-white dark:border-white/[.06] dark:bg-[#080b09]">
        <div className="mx-auto max-w-7xl px-5 py-24 lg:px-8">

          <div className="flex flex-col justify-between gap-8 md:flex-row md:items-end">
            <div className="max-w-2xl">
              <p className="text-[9px] font-semibold uppercase tracking-[.2em] text-emerald-700 dark:text-emerald-300">
                Current evidence
              </p>
              <h2 className="mt-4 text-4xl font-semibold tracking-[-.05em]">
                Research-backed signals.
              </h2>
              <p className="mt-5 text-sm leading-7 text-black/50 dark:text-white/45">
                These are measured research results, not simulated product
                outputs. Production validation remains an open step.
              </p>
            </div>

            <a
              href="https://github.com/yxshas565/mechguard"
              target="_blank"
              rel="noreferrer"
              className="inline-flex w-fit items-center gap-2 rounded-full border border-black/10 px-5 py-3 text-xs font-semibold dark:border-white/10"
            >
              <Activity size={14} />
              Explore research
            </a>
          </div>
                         )}
                       </div>
 
                       {stage === "attest" &&
                         Array.isArray(result.geometry) && (
                           <div className="mini-chart">
                             {result.geometry.slice(-24).map(
                               (point: any, index: number) => {
                                 const values = result.geometry
                                   .slice(-24)
                                   .map((p: any) =>
                                     Number(p.top_singular_value) || 0
                                   );
                                 const max = Math.max(...values, 1);
                                 const height =
                                   (Number(point.top_singular_value) / max) *
                                   100;
 
                                 return (
                                   <span
                                     key={`${point.step}-${index}`}
                                     style={{ height: `${Math.max(5, height)}%` }}
                                     title={`step ${point.step}: ${point.top_singular_value}`}
                                   />
                                 );
                               }
                             )}
                           </div>
                         )}
 
                       <div className="result-note">
                         <Sparkles size={15} />
                         <span>
                           {result.interpretation ??
                             result.message ??
                             "Evidence-backed result loaded."}
                         </span>
                       </div>
 
                       <button
                         type="button"
                         className="raw-toggle"
                         onClick={() => setShowRaw((value) => !value)}
                       >
                         {showRaw ? "Hide technical response" : "Inspect technical response"}
                         <ChevronDown
                           size={13}
                           className={showRaw ? "rotate-180" : ""}
                         />
                       </button>
 
                       {showRaw && (
                         <pre className="raw-output">
                           {JSON.stringify(result, null, 2)}
                         </pre>
                       )}
                     </div>
                   )}
                 </div>
               </div>
             </div>
           )}
         </div>
       </section>
 
       {/* EVIDENCE */}
       <section id="evidence" className="section evidence-section">
         <div className="section-heading">
           <div className="eyebrow">RESEARCH EVIDENCE</div>
           <h2>Measured signals. Clear limitations.</h2>
           <p>
             The product surface is connected to persisted MechGuard research
             evidence. It does not present simulated safety verdicts as live
             detection.
           </p>
         </div>
 
         <div className="evidence-grid">
           <button
             type="button"
             onClick={() => scrollToWorkspace}
             className="evidence-card"
           >
             <span>A001</span>
             <strong>8.36×</strong>
             <b>top singular value growth</b>
             <p>45 recorded checkpoints · Llama-3.2-1B</p>
             <ArrowRight size={15} />
           </button>
 
           <button
             type="button"
             onClick={() => scrollToWorkspace}
             className="evidence-card"
           >
             <span>B001</span>
             <strong>0.9677</strong>
             <b>agent-level OOF AUROC</b>
             <p>31 scenarios · 62 runs · 248 agents</p>
             <ArrowRight size={15} />
           </button>
 
           <button
             type="button"
             onClick={() => scrollToWorkspace}
             className="evidence-card"
           >
             <span>B003</span>
             <strong>1.00</strong>
             <b>layer OOF AUROC</b>
             <p>Layers 26–30 · broad representation confounds remain</p>
             <ArrowRight size={15} />
           </button>
         </div>
       </section>
 
       {/* FINAL CTA */}
       <section className="final-cta">
         <div className="eyebrow">MECHGUARD</div>
         <h2>Observe the layer<br />below the boundary.</h2>
         <p>
           Instrument. Measure. Surface. Review.
         </p>
         <button
           type="button"
           className="primary-btn"
           onClick={() =>
             document
               .getElementById("workspace")
               ?.scrollIntoView({ behavior: "smooth" })
           }
         >
           Open the workspace
           <ArrowRight size={15} />
         </button>
       </section>
 
       <footer className="footer">
         <span>MechGuard</span>
         <span>Mechanistic AI observability</span>
         <a
           href="https://github.com/yxshas565/mechguard"
           target="_blank"
           rel="noreferrer"
         >
           Research repository
         </a>
       </footer>
 </main>
   );
 }
