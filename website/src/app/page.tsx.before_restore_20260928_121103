          >
            <span className="relative flex h-4 w-4 items-center justify-center">
              {dark ? <Sun size={14} /> : <Moon size={14} />}
            </span>
            <span className="hidden sm:block">
              {dark ? "Light" : "Dark"}
            </span>
          </button>
